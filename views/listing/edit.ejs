<% layout('layouts/boilerplate.ejs') -%>

<body>
  <div class="form-wrapper">
    <h3>Edit This Listing: <%= editlisting._id %></h3>
    <form
      method="post"
      action="/listings/<%= editlisting._id %>?_method=patch"
      class="listing-form"
      enctype="multipart/form-data"
    >
      <input
        name="listing[title]"
        type="text"
        value="<%= editlisting.title %>"
        placeholder="Enter title"
        required
      />
      <textarea
        name="listing[description]"
        placeholder="Enter description"
        required
      >
<%= editlisting.description %></textarea
      >
      <br />
      <label>Original Image</label>
      <div>
        <br />
        <img src="<%= originalImageUrl %>" alt="Current listing image" />
      </div>
      <br />
      <label>Uplode New Image</label>
      <input name="listing[image]" type="file" />
      <input
        name="listing[price]"
        type="number"
        value="<%= editlisting.price %>"
        placeholder="Enter price"
        required
      />
      <input
        name="listing[location]"
        type="text"
        value="<%= editlisting.location %>"
        placeholder="Enter location"
        required
      />
      <input
        name="listing[country]"
        type="text"
        value="<%= editlisting.country %>"
        placeholder="Enter country"
        required
      />
      <button type="submit">Submit</button>
    </form>
  </div>
</body>
