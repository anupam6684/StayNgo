<!DOCTYPE html>
<html>
  <head>
    <title>Error</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f8d7da;
        color: #721c24;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
      }
      .error-box {
        background: #fff;
        padding: 20px 30px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        border-left: 6px solid #f44336;
      }
      h1 {
        margin-bottom: 10px;
      }
    </style>
  </head>
  <body>
    <div class="error-box">
      <h1>Oops! An Error Occurred</h1>
      <p><%= message %></p>
    </div>
  </body>
</html>
