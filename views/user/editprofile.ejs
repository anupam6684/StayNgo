<% layout('layouts/boilerplate') %>

<div class="edit-profile-container">
  <div class="edit-profile-card">
    <h2>Edit Profile</h2>
    <h2>ID:<%= currUser._id %></h2>

    <!-- Edit Profile Form -->
    <form
      action="/user/profile/edit?_method=patch"
      method="POST"
      class="edit-profile-form"
      enctype="multipart/form-data"
    >
      <!-- Current Profile Picture Preview -->
      <div class="profile-preview">
        <img
          src="<%= originalImageUrl || 'https://www.shutterstock.com/image-vector/user-profile-icon-vector-avatar-600nw-2247726673.jpg' %>"
          alt="Current Profile Picture"
        />
      </div>

      <!-- Profile Picture -->
      <div class="form-group">
        <label for="image"> Uplode Profile Picture</label>
        <input type="file" id="image" name="image" accept="image/*" />
      </div>
      <!-- Username -->
      <div class="form-group">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= currUser.username %>"
          required
        />
      </div>

      <!-- Email -->
      <div class="form-group">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= currUser.email %>"
          required
        />
      </div>

      <!-- Submit -->
      <div class="form-actions">
        <button type="submit" class="btn-edit">Save Changes</button>
        <a href="/user/profile" class="btn-edit btn-secondary-2">Cancel</a>
      </div>
    </form>
  </div>
</div>
