<% layout('layouts/boilerplate') %>

<div class="page-center" id="password-page">
  <div class="card card-password">
    <h2 class="title-password">Change Password</h2>

    <!-- Flash -->
    <% if(success && success.length > 0){ %>
    <div class="flash-success flash-password"><%= success %></div>
    <% } %> <% if(error && error.length > 0){ %>
    <div class="flash-error flash-password"><%= error %></div>
    <% } %>

    <form action="/user/profile/password" method="POST" class="form-password">
      <!-- Old Password -->
      <div class="form-group form-group-password">
        <label for="oldPassword" class="label-password">Current Password</label>
        <div class="password-wrapper">
          <input
            type="password"
            name="oldPassword"
            id="oldPassword"
            class="input-password"
            required
          />
          <span
            class="toggle-password"
            onclick="togglePassword('oldPassword', this)"
            >👁️</span
          >
        </div>
      </div>

      <!-- New Password -->
      <div class="form-group form-group-password">
        <label for="newPassword" class="label-password">New Password</label>
        <div class="password-wrapper">
          <input
            type="password"
            name="newPassword"
            id="newPassword"
            class="input-password"
            required
          />
          <span
            class="toggle-password"
            onclick="togglePassword('newPassword', this)"
            >👁️</span
          >
        </div>
      </div>

      <button type="submit" class="btn btn-password">Update Password</button>
    </form>

    <a href="/user/profile" class="back-link back-link-password"
      >⬅ Back to Profile</a
    >
  </div>
</div>

<script>
  // Toggle password show/hide
  function togglePassword(inputId, el) {
    const input = document.getElementById(inputId);
    if (input.type === "password") {
      input.type = "text";
      el.textContent = "🙈"; // change icon
    } else {
      input.type = "password";
      el.textContent = "👁️";
    }
  }
</script>
